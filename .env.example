# Shared
BRIA_DATA_DIR=~/.bria
BRIA_HOST_ID=local
BRIA_HOST_NAME=
BRIA_LOG_LEVEL=INFO

# Hub
BRIA_HUB_BIND=127.0.0.1
BRIA_HUB_PORT=8765
BRIA_LOCAL_RUNTIME=true

# Remote agent
BRIA_HUB_URL=
BRIA_AGENT_TOKEN=

# Optional Telegram product adapter on the hub. Keep the allowlist explicit.
BRIA_TELEGRAM_TOKEN=
BRIA_ALLOWED_USERS=

# Local runtime on either role
BRIA_TMUX_SESSION=bria
BRIA_CLAUDE_COMMAND=claude
BRIA_CODEX_COMMAND=codex
BRIA_EVENT_POLL_INTERVAL=1.0

# Optional TLS. Hub needs CERT+KEY; an agent may use a private CA file.
BRIA_TLS_CERT=
BRIA_TLS_KEY=
BRIA_TLS_CA=
